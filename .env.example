# Issuer of your Zitadel instance, for example https://your-instance.zitadel.cloud
VITE_ZITADEL_AUTHORITY=

# Client ID of the User Agent application
VITE_ZITADEL_CLIENT_ID=

# Passphrase that opens the files in data/. Kept off the VITE_ prefix so it is not copied into the browser bundle.
MISC_PASSPHRASE=
